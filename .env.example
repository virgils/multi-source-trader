# Copy this file to .env and fill in real values. .env is git-ignored — never commit real keys.

# Massive MCP (formerly Polygon.io) — price data, technical/market data
# Remote server at mcp.massive.com, authenticated via OAuth in Claude Code —
# no API key needed here, no env var to set.

# Octagon MCP — fundamentals, SEC filings, earnings transcripts, research
# Get a key at https://octagonai.co (API Keys section)
OCTAGON_API_KEY=

# Robinhood Agentic Trading MCP — execution (trade preview/execute, portfolio, technicals)
# Connection details come from your Robinhood agentic trading account setup.
ROBINHOOD_MCP_URL=
ROBINHOOD_API_KEY=
