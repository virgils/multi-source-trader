{
  "mcpServers": {
    "octagon": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "octagon-mcp@latest"],
      "env": {
        "OCTAGON_API_KEY": "${OCTAGON_API_KEY}"
      }
    },
    "massive": {
      "type": "http",
      "url": "https://mcp.massive.com/"
    },
    "robinhood": {
      "type": "http",
      "url": "${ROBINHOOD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${ROBINHOOD_API_KEY}"
      }
    }
  }
}
